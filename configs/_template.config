// =============================================================================
// Dataset config skeleton for the workflow manager route.
//
// Copy this file to configs/<dataset>.config, then replace the paths and labels.
// Values omitted here are inherited from phip-flow/nextflow.config.
// =============================================================================

params {
    // Input files. reads_prefix is prepended only to relative read paths.
    sample_table  = "/path/to/sample_table.csv"
    peptide_table = "/path/to/peptide_table.csv"
    reads_prefix  = "/path/to/reads"

    // Output location and dataset naming.
    results        = "${launchDir}/results/dataset"
    dataset_prefix = "dataset"
    dataset_label  = "dataset display name"

    // Read and library geometry. Longer reads can be trimmed to the insert span.
    read_length       = 151
    oligo_tile_length = 168
    n_mismatches      = 2
    trim5             = 0

    // Alignment backend and mode for this dataset.
    // alignment_mode: auto, PE, SE_R1 or SE_R2. auto picks PE when the sample
    // table gives an R2. SE_R2 suits a run whose R2 carries the better bases.
    aligner        = 'bowtie2'
    alignment_mode = 'SE_R1'

    // Optional cutadapt trimming before alignment.
    run_adapter_trim             = false
    adapter_r1_5p_list           = ''
    adapter_r2_5p_list           = ''
    adapter_match_read_wildcards = true
    adapter_min_length           = 50

    // Enrichment scoring. Each switch turns on one of the scoring steps the
    // bundled workflow provides. They are independent, so several can run in
    // one pass and each adds its own layer to the output dataset.
    //
    //   run_cpm_enr_workflow    fold enrichment over the library control samples
    //   run_zscore_fit_predict  binned z score against the beads-only samples
    //   run_gamma_poisson       gamma-Poisson model over size factors
    //   run_edgeR               edgeR, also the prior BEER consumes
    //   run_BEER                BEER posterior probability of enrichment
    //
    // BEER needs edgeR, so leave run_edgeR on whenever run_BEER is on.
    run_cpm_enr_workflow   = false
    run_zscore_fit_predict = false
    run_gamma_poisson      = false
    run_edgeR              = true
    run_BEER               = true

    // Thresholds for the switches above.
    zscore_threshold = 2.5
    edgeR_threshold  = 0.05

    // Gamma-Poisson settings, used only when run_gamma_poisson is true.
    gamma_poisson_starting_alpha  = 0.8
    gamma_poisson_starting_beta   = 0.1
    gamma_poisson_trim_percentile = 99.9

    // BEER settings. The seed is pinned because the sampler otherwise seeds
    // itself from the current date.
    beer_min_lib_size        = 500
    beer_posterior_threshold = 0.5
    beer_beads_rr            = false
    beer_seed                = 20260101

    // Output formats. Every scoring step above adds a layer to one dataset
    // object, and these control how that object is written. Wide CSV gives one
    // table per layer, which is how a z score or CPM matrix is read outside
    // the workflow.
    output_wide_csv      = true
    output_tall_csv      = false
    output_pickle_xarray = true

    // Optional analysis modules.
    run_library_qc               = false
    library_qc_dna_col           = 'oligo'

    run_contamination_diagnostic = false
    contamination_sources_dir    = "/path/to/contamination_sources"
    contamination_kmer_size      = 25
    run_contamination_blast      = false
}
