// =============================================================================
// Nextflow defaults for the phipstream workflow manager route.
//
// This file starts from upstream phip-flow settings and adapts deployment for
// this repository. Containers are pulled from registries at runtime, the Slurm
// profile is replaced with a PBS Computerome profile, and optional phipstream
// modules are controlled through params flags.
// =============================================================================

manifest {
    description = 'phipstream PhIP-Seq deployment'
    nextflowVersion = '>= 23.0.0'
}

// Let resumed or repeated runs replace report and trace files.
report {
    overwrite = true
}
trace {
    overwrite = true
}

params {
    /*
    Read input options.
    */
    fastq_stream_func = 'zcat'

    /*
    Output format options.
    */
    dataset_prefix       = 'data'
    output_pickle_xarray = true
    output_tall_csv      = false
    output_wide_csv      = true

    /*
    Alignment options.
    */
    // Aligner choice: 'bowtie1' for upstream compatibility or 'bowtie2'.
    aligner = 'bowtie1'

    read_length       = 125
    oligo_tile_length = 117
    n_mismatches      = 2
    trim5             = 0

    // The strand flag is not set here. short_read_alignment.sh adds --norc or
    // --nofw according to alignment_mode, so the two can never be passed together.
    bowtie_optional_args  = '--tryhard --nomaqround --best --sam --quiet'
    bowtie2_optional_args = '--very-sensitive-local --quiet'

    // Alignment mode: 'auto', 'PE', 'SE_R1' or 'SE_R2'.
    //   auto   paired-end when the sample table gives an R2, else SE_R1
    //   PE     require paired-end input, counting each fragment once
    //   SE_R1  align R1 only, forward strand
    //   SE_R2  align R2 only, reverse strand
    // 'SE' is accepted as a name for SE_R1.
    alignment_mode = 'auto'

    replicate_sequence_counts = true

    /*
    Optional cutadapt trimming before alignment.
    It is off by default, keeping the upstream assumption that sample tables
    already point at trimmed reads. When enabled, raw reads are trimmed inside
    the workflow before they reach the aligner.

    Adapter params are comma-separated sequence lists. Multiple entries become
    separate cutadapt flags, allowing mixed library geometries in one run.
    */
    run_adapter_trim                 = false
    adapter_r1_5p_list               = ''
    adapter_r1_3p_list               = ''
    adapter_r2_5p_list               = ''
    adapter_r2_3p_list               = ''
    adapter_match_read_wildcards     = true
    adapter_min_length               = 50

    /*
    Optional core workflow switches.
    */
    run_cpm_enr_workflow   = false
    run_zscore_fit_predict = false
    run_gamma_poisson      = false
    run_edgeR              = true
    run_BEER               = false

    /*
    BEER options. A fixed seed is supplied so repeated runs produce the same
    calls. The default matches the command line score stage.
    */
    beer_min_lib_size         = 500
    beer_posterior_threshold  = 0.5
    beer_beads_rr             = false
    beer_seed                 = 20260101

    /*
    Gamma-Poisson scorer settings used when run_gamma_poisson is true.
    Defaults follow phippery.modeling.gamma_poisson_model.
    */
    gamma_poisson_starting_alpha   = 0.8
    gamma_poisson_starting_beta    = 0.1
    gamma_poisson_trim_percentile  = 99.9

    /*
    Optional extension modules.
    */
    // Library sequence QC before synthesis or analysis.
    run_library_qc           = false
    library_qc_dna_col       = 'oligo'
    library_qc_protein_col   = 'peptide_translate'
    library_qc_id_col        = 'peptide_id'
    library_qc_organism_col  = 'virus'
    library_qc_trim5         = 0
    library_qc_trim3         = 0
    library_qc_thresholds    = ''

    // FastQC overrepresented-sequence contamination diagnostic.
    run_contamination_diagnostic   = false
    contamination_sources_dir      = "${projectDir}/data/contamination_sources"
    contamination_kmer_size        = 25
    // Dataset configs normally set this after params.results is known.
    fastqc_dir                     = ""
    fastqc_overrepresented_top_n   = 50

    // Optional BLAST follow-up for sequences left unassigned.
    run_contamination_blast = false
    blast_db                = 'nt'

    /*
    Organism and virus grouping inherited from upstream phip-flow.
    */
    summarize_by_organism = false
    peptide_org_col       = 'organism'
    peptide_seq_col       = 'seq'
    max_overlap           = 7
    zscore_threshold      = 2.5
    // Smallest bin the z score model will fit against. The bin count is about
    // the library size divided by this, so a small library gets very few bins.
    zscore_min_peptides_per_bin = 300
    edgeR_threshold       = 0.05
    sample_grouping_col   = ''
    public_epitopes_csv   = "$projectDir/templates/public_epitope_template.csv"
    public_epitopes_col   = 'peptide_translate'

    /*
    Container image references. Keep these as plain registry paths; Nextflow
    adds engine-specific prefixes when needed. Override them from a dataset
    config or the command line when using a mirror.
    */
    phipflow_image = 'quay.io/matsengrp/phip-flow:latest'
    beer_image     = 'quay.io/biocontainers/bioconductor-beer:1.2.0--r42hdfd78af_0'
    cutadapt_image = 'quay.io/biocontainers/cutadapt:5.2--py312hfabe715_2'
    bowtie2_image  = 'quay.io/biocontainers/bowtie2:2.5.4--he96a11b_7'
    samtools_image = 'quay.io/biocontainers/samtools:1.19.2--h50ea8bc_1'

    /*
    Deployment settings.
    */
    computerome_project = ''
    // Scheduler queue for the computerome profile. An invalid name fails the
    // first submitted process with "Unknown queue MSG=requested queue not
    // found", so list the site's queues with qstat -Q before changing it.
    queue = 'batch'
}

// The base phip-flow image supplies bowtie 1, samtools, and phippery. Processes
// needing bowtie 2, cutadapt, or BEER are routed to dedicated images.
process {
    container = "${params.phipflow_image}"
    withName: 'run_edgeR|run_BEER'  { container = "${params.beer_image}" }
    withName: 'trim_adapters'       { container = "${params.cutadapt_image}" }
    withName: 'generate_index|short_read_alignment' {
        container = { params.aligner == 'bowtie2' ? params.bowtie2_image
                                                  : params.phipflow_image }
    }
    withName: 'sam_to_counts|sam_to_stats' { container = "${params.samtools_image}" }
}

profiles {

    standard {
    }

    // Default deployment profile using Apptainer and its shared image cache.
    apptainer {
        apptainer {
            enabled    = true
            autoMounts = true
            cacheDir   = "${System.getenv('NXF_APPTAINER_CACHEDIR') ?: "${System.getProperty('user.home')}/.apptainer/cache"}"
        }
    }

    // Native Docker profile for workstations with a running Docker daemon.
    docker {
        docker.enabled    = true
        docker.runOptions = '-u $(id -u):$(id -g)'
    }

    computerome {
        apptainer {
            enabled    = true
            autoMounts = true
            cacheDir   = "${System.getenv('NXF_APPTAINER_CACHEDIR') ?: "${System.getProperty('user.home')}/.apptainer/cache"}"
        }
        process {
            executor       = 'pbspro'
            queue          = params.queue
            cpus           = 4
            memory         = '16 GB'
            time           = '12h'
            clusterOptions = "-A ${params.computerome_project} -W group_list=${params.computerome_project}"

            withLabel: mem_small     { cpus = 2; memory = '8 GB' }
            withLabel: mem_large     { cpus = 4; memory = '48 GB' }
            withLabel: mem_xlarge    { cpus = 8; memory = '128 GB' }
            withLabel: alignment_tool { cpus = 8; memory = '32 GB' }
        }
    }
}
